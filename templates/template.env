# ----------------------------------------------------------------
# PROJECT SETTINGS
# ----------------------------------------------------------------

MODULE_NAME="example_package"
DEFAULT_MODULE="Example"

# ----------------------------------------------------------------
# LOCAL SYSTEM SETTINGS
# ----------------------------------------------------------------

# ... linux users
# PYTHON_PATH="python3.14"

# ... windows users
PYTHON_PATH="py -3.14"

# see https://doc.rust-lang.org/rustc/platform-support.html
# CARGO_BUILD_TARGET="x86_64-unknown-linux-gnu" # linux
# CARGO_BUILD_TARGET="aarch64-apple-darwin" # osx
CARGO_BUILD_TARGET="x86_64-pc-windows-gnu" # windows

# Rust debugging levels
RUST_BACKTRACE=0
# RUST_BACKTRACE=1
# RUST_BACKTRACE=full
